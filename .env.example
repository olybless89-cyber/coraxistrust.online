# Coraxis Trust — environment variables
# Copy this file to `.env` and fill in your OWN values.
# Never commit the real `.env` (it is gitignored).

# ── Supabase (client) ────────────────────────────────────────────────────────
# Your own Supabase project for coraxistrust.online.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Error monitoring (optional) ──────────────────────────────────────────────
VITE_SENTRY_DSN=

# ── Supabase Edge Function: send-email (server-side only) ────────────────────
# Set these as Edge Function secrets (`supabase secrets set ...`), not in the frontend.
RESEND_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email branding (used by the send-email Edge Function) ────────────────────
SMTP_FROM_NAME=Coraxis Trust
SMTP_FROM_EMAIL=noreply@coraxistrust.online
SMTP_REPLY_TO=support@coraxistrust.online

